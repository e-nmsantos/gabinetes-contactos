    let currentCabinet = 'ALL';
    let currentArea = 'ALL';
    let currentTab = 'contacts';
    let viewMode = 'cards';
    let currentTheme = 'light';

    document.getElementById('stat-contacts').innerText = contacts.length;

    function getInitials(name) {
      if (!name) return 'MF';
      const clean = name.replace(/^(Dr\.|Dra\.|Eng\.|Prof\.)\s+/i, '').trim();
      const parts = clean.split(/\s+/).filter(Boolean);
      if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
      return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
    }

    function normalizeStr(str) {
      return (str || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();
    }

    function toggleTheme() {
      currentTheme = currentTheme === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', currentTheme);
      const btn = document.getElementById('themeBtn');
      if (currentTheme === 'dark') {
        btn.innerHTML = '&#9728;&#65039;';
      } else {
        btn.innerHTML = '&#127769;';
      }
    }

    function toggleViewMode() {
      viewMode = viewMode === 'cards' ? 'table' : 'cards';
      const text = document.getElementById('viewModeText');
      if (viewMode === 'table') {
        text.innerText = 'CartÃµes';
        document.getElementById('contactsGrid').style.display = 'none';
        document.getElementById('contactsTableContainer').style.display = 'block';
      } else {
        text.innerText = 'Tabela';
        document.getElementById('contactsGrid').style.display = 'grid';
        document.getElementById('contactsTableContainer').style.display = 'none';
      }
      filterData();
    }

    function switchTab(tab) {
      currentTab = tab;
      document.getElementById('tabBtnContacts').classList.toggle('active', tab === 'contacts');
      document.getElementById('tabBtnResources').classList.toggle('active', tab === 'resources');
      document.getElementById('areaFilterGroup').style.display = tab === 'contacts' ? 'inline-flex' : 'none';
      document.getElementById('areaLabel').style.display = tab === 'contacts' ? 'inline' : 'none';
      document.getElementById('viewToggleBtn').style.display = tab === 'contacts' ? 'flex' : 'none';

      if (tab === 'contacts') {
        document.getElementById('contactsView').style.display = 'block';
        document.getElementById('resourcesView').style.display = 'none';
      } else {
        document.getElementById('contactsView').style.display = 'none';
        document.getElementById('resourcesView').style.display = 'block';
      }
      filterData();
    }

    function setCabinet(cab) {
      currentCabinet = cab;
      const gabs = ['ALL', 'SEAO', 'SEAF', 'SEAP'];
      gabs.forEach(g => {
        const el = document.getElementById(`btnGab-${g}`);
        if (el) el.classList.toggle('active', g === cab);
      });
      filterData();
    }

    function setArea(area) {
      currentArea = area;
      const btns = document.querySelectorAll('#areaFilterGroup .mac-filter-item');
      btns.forEach(btn => {
        btn.classList.toggle('active', btn.innerText === area || (area === 'ALL' && btn.innerText === 'Todas'));
      });
      filterData();
    }

    function copyText(val, label) {
      if (!val || val === 'â€”' || val === '-') return;
      const clean = val.replace(/\s+/g, ' ').trim();
      navigator.clipboard.writeText(clean).then(() => {
        showToast(`&#128203; ${label}: "${clean}" copiado!`);
      }).catch(() => {
        showToast(`&#128203; ${clean} copiado!`);
      });
    }

    function showToast(msg) {
      const t = document.getElementById('toast');
      t.innerHTML = msg;
      t.classList.add('show');
      setTimeout(() => { t.classList.remove('show'); }, 2200);
    }

    function downloadVCard(c) {
      const nome = c['Nome'] || 'Contacto';
      const cargo = c['Cargo'] || '';
      const gab = c['Gabinete'] || '';
      const email = c['E-mail'] || '';
      const tel = c['Telefone Direto'] || '';
      const movel = c['TelemÃ³vel'] || '';
      const ramal = c['Ramal Interno'] || '';

      const vcard = [
        'BEGIN:VCARD',
        'VERSION:3.0',
        `FN:${nome}`,
        `ORG:MinistÃ©rio das FinanÃ§as;Gabinete ${gab}`,
        `TITLE:${cargo}`,
        email ? `EMAIL;TYPE=INTERNET,WORK:${email}` : '',
        tel ? `TEL;TYPE=WORK,VOICE:${tel}` : '',
        movel ? `TEL;TYPE=CELL,VOICE:${movel}` : '',
        ramal ? `NOTE:Ramal VOIP: ${ramal}` : '',
        'END:VCARD'
      ].filter(Boolean).join('\r\n');

      const blob = new Blob([vcard], { type: 'text/vcard;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `${nome.replace(/\s+/g, '_')}.vcf`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast(`&#128100; Contacto ${nome} descarregado (.vcf)!`);
    }

    let lastFilteredContacts = [];
    let lastFilteredResources = [];

    function filterData() {
      const rawQuery = document.getElementById('searchInput').value;
      const query = normalizeStr(rawQuery);

      if (currentTab === 'contacts') {
        lastFilteredContacts = contacts.filter(c => {
          const matchCab = currentCabinet === 'ALL' || c['Gabinete'] === currentCabinet;
          const areaVal = c['Ãrea / FunÃ§Ã£o'] || c['Area / Funcao'] || '';
          let matchArea = true;
          if (currentArea === 'Gabinete') {
            matchArea = normalizeStr(areaVal).includes('gabinete');
          } else if (currentArea === 'Secretaria') {
            matchArea = normalizeStr(areaVal).includes('secretaria');
          }

          const searchStr = normalizeStr(`${c['Nome']} ${c['Cargo']} ${c['E-mail']} ${c['Ramal Interno']} ${c['TelemÃ³vel']} ${c['Telefone Direto']} ${c['Piso / Sala']} ${areaVal}`);
          const matchQuery = !query || searchStr.includes(query);
          return matchCab && matchArea && matchQuery;
        });
        renderContacts(lastFilteredContacts);
      } else {
        lastFilteredResources = resources.filter(r => {
          const matchCab = currentCabinet === 'ALL' || r['Gabinete'] === currentCabinet;
          const searchStr = normalizeStr(`${r['DesignaÃ§Ã£o / Recurso']} ${r['Tipo de Recurso']} ${r['ResponsÃ¡vel / Motorista']} ${r['TelemÃ³vel / Telefone']} ${r['Identificador / MatrÃ­cula']} ${r['Capacidade / Detalhes']}`);
          const matchQuery = !query || searchStr.includes(query);
          return matchCab && matchQuery;
        });
        renderResources(lastFilteredResources);
      }
    }

    function renderContacts(data) {
      const grid = document.getElementById('contactsGrid');
      const tableBody = document.getElementById('contactsTableBody');

      if (!data.length) {
        grid.innerHTML = '<div class="empty-state" style="grid-column: 1/-1;">Nenhum colaborador encontrado para a pesquisa.</div>';
        tableBody.innerHTML = '<tr><td colspan="10" class="empty-state">Nenhum colaborador encontrado.</td></tr>';
        return;
      }

      grid.innerHTML = data.map((c, idx) => {
        const gab = c['Gabinete'] || 'SEAO';
        const badgeClass = gab === 'SEAO' ? 'badge-seao' : (gab === 'SEAF' ? 'badge-seaf' : 'badge-seap');
        const avatarClass = gab === 'SEAO' ? 'avatar-seao' : (gab === 'SEAF' ? 'avatar-seaf' : 'avatar-seap');
        const phone = (c['Telefone Direto'] && c['Telefone Direto'] !== 'â€”' && c['Telefone Direto'] !== '-') ? c['Telefone Direto'] : '';
        const mobile = (c['TelemÃ³vel'] && c['TelemÃ³vel'] !== 'â€”' && c['TelemÃ³vel'] !== '-') ? c['TelemÃ³vel'] : '';
        const email = (c['E-mail'] && c['E-mail'] !== 'â€”' && c['E-mail'] !== '-') ? c['E-mail'] : '';
        const ramal = (c['Ramal Interno'] && c['Ramal Interno'] !== 'â€”' && c['Ramal Interno'] !== '-') ? c['Ramal Interno'] : '';
        const sala = (c['Piso / Sala'] && c['Piso / Sala'] !== 'â€”' && c['Piso / Sala'] !== '-') ? c['Piso / Sala'] : '';
        const callTarget = mobile || phone;
        const areaName = c['Ãrea / FunÃ§Ã£o'] || c['Area / Funcao'] || 'Gabinete';
        const initials = getInitials(c['Nome']);

        return `
          <div class="mac-card">
            <div>
              <div class="mac-card-header">
                <span class="mac-badge ${badgeClass}">${gab} &bull; ${areaName}</span>
                ${sala ? `<span class="mac-room-chip">${sala}</span>` : ''}
              </div>
              
              <div class="mac-profile-row">
                <div class="mac-squircle-avatar ${avatarClass}">${initials}</div>
                <div class="mac-person-details">
                  <div class="mac-person-name" title="${c['Nome']}">${c['Nome']}</div>
                  <div class="mac-person-role" title="${c['Cargo']}">${c['Cargo']}</div>
                </div>
              </div>

              <div class="mac-contact-list">
                ${ramal ? `
                  <div class="mac-contact-entry">
                    <span class="mac-field-tag">Ramal</span>
                    <span class="mac-voip-pill">VOIP ${ramal}</span>
                    <button class="mac-copy-btn" onclick="copyText('${ramal}', 'Ramal')" title="Copiar Ramal">&#128203;</button>
                  </div>
                ` : ''}
                ${phone ? `
                  <div class="mac-contact-entry">
                    <span class="mac-field-tag">Direto</span>
                    <a href="tel:${phone.replace(/\s+/g, '')}">${phone}</a>
                    <button class="mac-copy-btn" onclick="copyText('${phone}', 'Telefone Direto')" title="Copiar Direto">&#128203;</button>
                  </div>
                ` : ''}
                ${mobile ? `
                  <div class="mac-contact-entry">
                    <span class="mac-field-tag">MÃ³vel</span>
                    <a href="tel:${mobile.replace(/\s+/g, '')}">${mobile}</a>
                    <button class="mac-copy-btn" onclick="copyText('${mobile}', 'TelemÃ³vel')" title="Copiar TelemÃ³vel">&#128203;</button>
                  </div>
                ` : ''}
                ${email ? `
                  <div class="mac-contact-entry">
                    <span class="mac-field-tag">E-mail</span>
                    <a href="mailto:${email}">${email}</a>
                    <button class="mac-copy-btn" onclick="copyText('${email}', 'E-mail')" title="Copiar E-mail">&#128203;</button>
                  </div>
                ` : ''}
              </div>
            </div>

            <div class="mac-card-footer">
              ${callTarget ? `<a class="mac-btn-action primary" href="tel:${callTarget.replace(/\s+/g, '')}" title="Efetuar Chamada">&#128222; Ligar</a>` : ''}
              ${email ? `
                <a class="mac-btn-action teams" href="msteams:/l/chat/0/0?users=${email}" title="Conversar no Microsoft Teams">&#128172; Teams</a>
                <a class="mac-btn-action" href="mailto:${email}" title="Enviar E-mail via Outlook">&#9993; Email</a>
              ` : ''}
              <button class="mac-btn-action vcf" onclick="downloadVCard(contacts[${idx}])" title="Guardar Contacto (vCard .vcf)">&#128100;</button>
            </div>
          </div>
        `;
      }).join('');

      tableBody.innerHTML = data.map((c, idx) => {
        const gab = c['Gabinete'] || 'SEAO';
        const badgeClass = gab === 'SEAO' ? 'badge-seao' : (gab === 'SEAF' ? 'badge-seaf' : 'badge-seap');
        const phone = (c['Telefone Direto'] && c['Telefone Direto'] !== 'â€”' && c['Telefone Direto'] !== '-') ? c['Telefone Direto'] : '';
        const mobile = (c['TelemÃ³vel'] && c['TelemÃ³vel'] !== 'â€”' && c['TelemÃ³vel'] !== '-') ? c['TelemÃ³vel'] : '';
        const email = (c['E-mail'] && c['E-mail'] !== 'â€”' && c['E-mail'] !== '-') ? c['E-mail'] : '';
        const ramal = (c['Ramal Interno'] && c['Ramal Interno'] !== 'â€”' && c['Ramal Interno'] !== '-') ? c['Ramal Interno'] : '';
        const sala = (c['Piso / Sala'] && c['Piso / Sala'] !== 'â€”' && c['Piso / Sala'] !== '-') ? c['Piso / Sala'] : '';
        const callTarget = mobile || phone;
        const areaVal = c['Ãrea / FunÃ§Ã£o'] || c['Area / Funcao'] || 'Gabinete';

        return `
          <tr>
            <td><span class="mac-badge ${badgeClass}">${gab}</span></td>
            <td>${areaVal}</td>
            <td><strong>${c['Cargo']}</strong></td>
            <td>${c['Nome']}</td>
            <td>${ramal ? `<span class="mac-voip-pill">${ramal}</span> <button class="mac-copy-btn" onclick="copyText('${ramal}', 'Ramal')">&#128203;</button>` : 'â€”'}</td>
            <td>${phone ? `<a href="tel:${phone.replace(/\s+/g, '')}">${phone}</a> <button class="mac-copy-btn" onclick="copyText('${phone}', 'Telefone')">&#128203;</button>` : 'â€”'}</td>
            <td>${mobile ? `<a href="tel:${mobile.replace(/\s+/g, '')}">${mobile}</a> <button class="mac-copy-btn" onclick="copyText('${mobile}', 'MÃ³vel')">&#128203;</button>` : 'â€”'}</td>
            <td>${sala || 'â€”'}</td>
            <td>${email ? `<a href="mailto:${email}">${email}</a> <button class="mac-copy-btn" onclick="copyText('${email}', 'Email')">&#128203;</button>` : 'â€”'}</td>
            <td>
              <div style="display: flex; gap: 4px;">
                ${callTarget ? `<a class="mac-tool-btn" style="padding: 3px 6px;" href="tel:${callTarget.replace(/\s+/g, '')}" title="Ligar">&#128222;</a>` : ''}
                ${email ? `
                  <a class="mac-tool-btn" style="padding: 3px 6px; background: var(--teams); color: white; border-color: var(--teams);" href="msteams:/l/chat/0/0?users=${email}" title="Teams">&#128172;</a>
                  <a class="mac-tool-btn" style="padding: 3px 6px;" href="mailto:${email}" title="Email">&#9993;</a>
                ` : ''}
                <button class="mac-tool-btn" style="padding: 3px 6px;" onclick="downloadVCard(contacts[${idx}])" title="vCard">&#128100;</button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    function renderResources(data) {
      const tbody = document.getElementById('resourcesBody');
      if (!data.length) {
        tbody.innerHTML = '<tr><td colspan="8" class="empty-state">Nenhum recurso encontrado.</td></tr>';
        return;
      }
      tbody.innerHTML = data.map(r => {
        const badgeClass = r['Gabinete'] === 'SEAO' ? 'badge-seao' : (r['Gabinete'] === 'SEAF' ? 'badge-seaf' : 'badge-seap');
        const cont = r['TelemÃ³vel / Telefone'] || '';
        const email = r['E-mail'] || '';
        const callTarget = cont ? cont.split('/')[0].trim() : '';

        return `
          <tr>
            <td><span class="mac-badge ${badgeClass}">${r['Gabinete']}</span></td>
            <td><strong>${r['Tipo de Recurso']}</strong></td>
            <td>${r['DesignaÃ§Ã£o / Recurso']}</td>
            <td>${r['ResponsÃ¡vel / Motorista'] || 'â€”'}</td>
            <td>
              ${cont ? `${cont} <button class="mac-copy-btn" onclick="copyText('${cont}', 'Contacto')">&#128203;</button>` : 'â€”'}
            </td>
            <td><code>${r['Identificador / MatrÃ­cula'] || 'â€”'}</code></td>
            <td>${r['Capacidade / Detalhes'] || 'â€”'}</td>
            <td>
              <div style="display: flex; gap: 4px;">
                ${callTarget ? `<a class="mac-tool-btn" style="padding: 3px 6px;" href="tel:${callTarget.replace(/\s+/g, '')}" title="Ligar">&#128222;</a>` : ''}
                ${email ? `<a class="mac-tool-btn" style="padding: 3px 6px;" href="mailto:${email}" title="Email">&#9993;</a>` : ''}
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    function exportToCSV() {
      const isContacts = currentTab === 'contacts';
      const data = isContacts ? lastFilteredContacts : lastFilteredResources;
      if (!data.length) {
        alert('NÃ£o hÃ¡ dados para exportar com os filtros atuais.');
        return;
      }

      let csvContent = '\uFEFF';
      if (isContacts) {
        csvContent += "Gabinete;Ãrea;Cargo;Nome;E-mail;Telefone Direto;Ramal VOIP;TelemÃ³vel;Piso / Sala;Notas\r\n";
        data.forEach(c => {
          const aName = c['Ãrea / FunÃ§Ã£o'] || c['Area / Funcao'] || '';
          csvContent += `"${c['Gabinete'] || ''}";"${aName}";"${c['Cargo'] || ''}";"${c['Nome'] || ''}";"${c['E-mail'] || ''}";"${c['Telefone Direto'] || ''}";"${c['Ramal Interno'] || ''}";"${c['TelemÃ³vel'] || ''}";"${c['Piso / Sala'] || ''}";"${c['Notas'] || ''}"\r\n`;
        });
      } else {
        csvContent += "Gabinete;Tipo;DesignaÃ§Ã£o;ResponsÃ¡vel;E-mail;Contacto;MatrÃ­cula / Sala;Detalhes\r\n";
        data.forEach(r => {
          csvContent += `"${r['Gabinete'] || ''}";"${r['Tipo de Recurso'] || ''}";"${r['DesignaÃ§Ã£o / Recurso'] || ''}";"${r['ResponsÃ¡vel / Motorista'] || ''}";"${r['E-mail'] || ''}";"${r['TelemÃ³vel / Telefone'] || ''}";"${r['Identificador / MatrÃ­cula'] || ''}";"${r['Capacidade / Detalhes'] || ''}"\r\n`;
        });
      }

      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `Diretorio_Gabinetes_${isContacts ? 'Contactos' : 'Recursos'}_${new Date().toISOString().slice(0,10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast('&#128229; Ficheiro CSV gerado com sucesso!');
    }

    document.addEventListener('keydown', (e) => {
      const searchInput = document.getElementById('searchInput');
      if (e.key === '/' && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput.focus();
        searchInput.select();
      } else if (e.key === 'Escape') {
        if (searchInput.value) {
          searchInput.value = '';
          filterData();
        }
        searchInput.blur();
      } else if (document.activeElement !== searchInput) {
        if (e.key === '1') setCabinet('ALL');
        else if (e.key === '2') setCabinet('SEAO');
        else if (e.key === '3') setCabinet('SEAF');
        else if (e.key === '4') setCabinet('SEAP');
      }
    });

    filterData();
  </script>
</body>
</html>