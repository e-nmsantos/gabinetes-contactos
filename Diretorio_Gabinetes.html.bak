<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Diretório Institucional — Gabinetes MF</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=SF+Pro+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      /* macOS Light Mode Palette */
      --mac-bg: #f5f5f7;
      --mac-window-bg: rgba(255, 255, 255, 0.85);
      --mac-sidebar-bg: rgba(240, 240, 245, 0.75);
      --mac-card-bg: #ffffff;
      --mac-card-border: rgba(0, 0, 0, 0.07);
      --mac-card-shadow: 0 4px 16px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.03);
      --mac-card-hover-shadow: 0 12px 28px rgba(0, 0, 0, 0.09), 0 2px 6px rgba(0, 0, 0, 0.04);
      --mac-text: #1d1d1f;
      --mac-text-secondary: #86868b;
      --mac-border: rgba(0, 0, 0, 0.08);
      --mac-accent: #0071e3;
      --mac-accent-hover: #0077ed;
      --mac-pill-bg: #e8e8ed;
      --mac-pill-text: #1d1d1f;
      
      --badge-seao-bg: rgba(0, 113, 227, 0.1);
      --badge-seao-color: #0071e3;
      --badge-seaf-bg: rgba(52, 199, 89, 0.12);
      --badge-seaf-color: #248a3d;
      --badge-seap-bg: rgba(175, 82, 222, 0.12);
      --badge-seap-color: #8944ab;

      --teams: #505ac9;
      --teams-hover: #434cb2;
    }

    [data-theme="dark"] {
      /* macOS Dark Mode / Sonoma Palette */
      --mac-bg: #161618;
      --mac-window-bg: rgba(30, 30, 34, 0.85);
      --mac-sidebar-bg: rgba(24, 24, 28, 0.75);
      --mac-card-bg: #222226;
      --mac-card-border: rgba(255, 255, 255, 0.08);
      --mac-card-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
      --mac-card-hover-shadow: 0 14px 34px rgba(0, 0, 0, 0.55);
      --mac-text: #f5f5f7;
      --mac-text-secondary: #a1a1a6;
      --mac-border: rgba(255, 255, 255, 0.1);
      --mac-accent: #2997ff;
      --mac-accent-hover: #47a6ff;
      --mac-pill-bg: #323236;
      --mac-pill-text: #f5f5f7;

      --badge-seao-bg: rgba(41, 151, 255, 0.2);
      --badge-seao-color: #64b5f6;
      --badge-seaf-bg: rgba(48, 209, 88, 0.2);
      --badge-seaf-color: #81c784;
      --badge-seap-bg: rgba(191, 90, 242, 0.22);
      --badge-seap-color: #ce93d8;

      --teams: #6366f1;
      --teams-hover: #4f46e5;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Icons", "Helvetica Neue", "Inter", sans-serif; -webkit-font-smoothing: antialiased; }
    body {
      background: var(--mac-bg);
      color: var(--mac-text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 0;
      transition: background-color 0.25s, color 0.25s;
    }

    /* macOS Unified Window Header (Toolbar + Traffic Lights) */
    .mac-window-header {
      background: var(--mac-window-bg);
      backdrop-filter: blur(24px) saturate(180%);
      -webkit-backdrop-filter: blur(24px) saturate(180%);
      border-bottom: 1px solid var(--mac-border);
      position: sticky;
      top: 0;
      z-index: 1000;
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .mac-left-section {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    /* macOS Traffic Light Buttons */
    .mac-traffic-lights {
      display: flex;
      gap: 8px;
      align-items: center;
    }
    .traffic-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      display: inline-block;
      cursor: pointer;
      transition: opacity 0.15s, transform 0.15s;
      position: relative;
    }
    .traffic-dot:hover { transform: scale(1.08); }
    .dot-close { background: #ff5f56; border: 1px solid #e0443e; }
    .dot-minimize { background: #ffbd2e; border: 1px solid #dea123; }
    .dot-expand { background: #27c93f; border: 1px solid #1aab29; }

    .mac-title-group {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .mac-republica-emblem {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: linear-gradient(135deg, #0b2545, #0071e3);
      padding: 3px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 6px rgba(0,0,0,0.12);
    }
    .mac-republica-emblem svg { width: 24px; height: 24px; }

    .mac-title-text h1 {
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: -0.015em;
      color: var(--mac-text);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .mac-title-text p {
      font-size: 0.72rem;
      color: var(--mac-text-secondary);
      font-weight: 500;
    }

    /* macOS Segmented Switch (Tabs) */
    .mac-segmented-control {
      background: var(--mac-pill-bg);
      padding: 3px;
      border-radius: 9px;
      display: inline-flex;
      border: 1px solid var(--mac-border);
    }
    .mac-segment-btn {
      background: none;
      border: none;
      padding: 6px 15px;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--mac-text-secondary);
      cursor: pointer;
      border-radius: 7px;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .mac-segment-btn.active {
      background: var(--mac-card-bg);
      color: var(--mac-text);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08), 0 1px 1px rgba(0,0,0,0.04);
    }

    .mac-right-section {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .mac-pill-badge {
      background: var(--mac-pill-bg);
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.74rem;
      font-weight: 600;
      color: var(--mac-text-secondary);
      border: 1px solid var(--mac-border);
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .mac-pill-badge strong { color: var(--mac-accent); }

    .mac-btn-icon {
      background: var(--mac-card-bg);
      border: 1px solid var(--mac-border);
      color: var(--mac-text);
      width: 32px;
      height: 32px;
      border-radius: 8px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.95rem;
      box-shadow: 0 1px 2px rgba(0,0,0,0.04);
      transition: all 0.15s;
    }
    .mac-btn-icon:hover {
      background: var(--mac-pill-bg);
      border-color: var(--mac-border);
    }

    /* Sub-header / Filter Toolbar */
    .container {
      max-width: 1360px;
      width: 100%;
      margin: 0 auto;
      padding: 20px 24px;
      flex: 1;
    }

    /* macOS Frosted Filter Bar */
    .mac-toolbar {
      background: var(--mac-card-bg);
      border: 1px solid var(--mac-card-border);
      border-radius: 14px;
      padding: 12px 18px;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      align-items: center;
      margin-bottom: 22px;
      box-shadow: var(--mac-card-shadow);
    }

    /* macOS Native Search Box */
    .mac-search-wrapper {
      position: relative;
      flex: 1;
      min-width: 270px;
    }
    .mac-search-wrapper input {
      width: 100%;
      background: var(--mac-bg);
      border: 1px solid var(--mac-border);
      border-radius: 10px;
      padding: 8px 12px 8px 34px;
      font-size: 0.86rem;
      color: var(--mac-text);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .mac-search-wrapper input:focus {
      border-color: var(--mac-accent);
      box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.15);
      background: var(--mac-card-bg);
    }
    .mac-search-icon {
      position: absolute;
      left: 11px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--mac-text-secondary);
      font-size: 0.85rem;
      pointer-events: none;
    }

    /* macOS Segmented Filter Buttons */
    .mac-filter-label {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--mac-text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-right: 2px;
    }
    .mac-segmented-group {
      display: inline-flex;
      background: var(--mac-bg);
      padding: 3px;
      border-radius: 9px;
      border: 1px solid var(--mac-border);
    }
    .mac-filter-item {
      background: none;
      border: none;
      padding: 5px 12px;
      border-radius: 7px;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--mac-text-secondary);
      cursor: pointer;
      transition: all 0.15s;
    }
    .mac-filter-item:hover { color: var(--mac-text); }
    .mac-filter-item.active {
      background: var(--mac-card-bg);
      color: var(--mac-text);
      box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    }

    /* Quick Action Tools */
    .mac-actions-group {
      display: flex;
      gap: 8px;
      align-items: center;
      margin-left: auto;
    }
    .mac-tool-btn {
      background: var(--mac-bg);
      border: 1px solid var(--mac-border);
      color: var(--mac-text);
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: all 0.15s;
    }
    .mac-tool-btn:hover {
      background: var(--mac-pill-bg);
      border-color: var(--mac-card-border);
    }

    /* macOS Cards Grid */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
      gap: 18px;
    }

    /* macOS Style Card */
    .mac-card {
      background: var(--mac-card-bg);
      border: 1px solid var(--mac-card-border);
      border-radius: 16px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: var(--mac-card-shadow);
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s;
      position: relative;
    }
    .mac-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--mac-card-hover-shadow);
      border-color: rgba(0, 113, 227, 0.25);
    }

    .mac-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 12px;
    }
    .mac-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 9px;
      border-radius: 20px;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.02em;
    }
    .badge-seao { background: var(--badge-seao-bg); color: var(--badge-seao-color); }
    .badge-seaf { background: var(--badge-seaf-bg); color: var(--badge-seaf-color); }
    .badge-seap { background: var(--badge-seap-bg); color: var(--badge-seap-color); }

    .mac-room-chip {
      background: var(--mac-bg);
      border: 1px solid var(--mac-border);
      color: var(--mac-text-secondary);
      font-size: 0.72rem;
      font-weight: 600;
      padding: 3px 9px;
      border-radius: 20px;
    }

    /* Profile Group with Apple-style Squircle Avatar */
    .mac-profile-row {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 14px;
    }
    .mac-squircle-avatar {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.95rem;
      color: white;
      flex-shrink: 0;
      box-shadow: 0 3px 8px rgba(0,0,0,0.12);
    }
    .avatar-seao { background: linear-gradient(145deg, #0071e3, #004fb0); }
    .avatar-seaf { background: linear-gradient(145deg, #34c759, #248a3d); }
    .avatar-seap { background: linear-gradient(145deg, #af52de, #7d37a3); }

    .mac-person-details { flex: 1; min-width: 0; }
    .mac-person-name {
      font-size: 1.02rem;
      font-weight: 700;
      color: var(--mac-text);
      letter-spacing: -0.01em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .mac-person-role {
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--mac-text-secondary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-top: 1px;
    }

    /* Contact Details Rows */
    .mac-contact-list {
      display: flex;
      flex-direction: column;
      gap: 7px;
      font-size: 0.83rem;
    }
    .mac-contact-entry {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--mac-text);
    }
    .mac-field-tag {
      color: var(--mac-text-secondary);
      font-size: 0.7rem;
      width: 54px;
      text-transform: uppercase;
      font-weight: 600;
      letter-spacing: 0.03em;
    }
    .mac-contact-entry a {
      color: var(--mac-accent);
      text-decoration: none;
      font-weight: 500;
    }
    .mac-contact-entry a:hover { text-decoration: underline; }

    .mac-voip-pill {
      background: rgba(0, 113, 227, 0.08);
      color: var(--mac-accent);
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 6px;
      font-size: 0.78rem;
    }

    /* Clipboard Copy Action */
    .mac-copy-btn {
      background: none;
      border: none;
      cursor: pointer;
      color: var(--mac-text-secondary);
      font-size: 0.78rem;
      padding: 2px 5px;
      border-radius: 5px;
      opacity: 0.5;
      transition: opacity 0.15s, color 0.15s, background-color 0.15s;
    }
    .mac-copy-btn:hover {
      opacity: 1;
      color: var(--mac-accent);
      background: var(--mac-bg);
    }

    /* Apple-like Quick Action Buttons */
    .mac-card-footer {
      margin-top: 16px;
      padding-top: 14px;
      border-top: 1px solid var(--mac-border);
      display: flex;
      gap: 6px;
    }
    .mac-btn-action {
      flex: 1;
      text-align: center;
      padding: 7px 10px;
      border-radius: 9px;
      font-size: 0.78rem;
      font-weight: 600;
      text-decoration: none;
      background: var(--mac-bg);
      border: 1px solid var(--mac-border);
      color: var(--mac-text);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      transition: all 0.15s;
    }
    .mac-btn-action:hover {
      background: var(--mac-pill-bg);
      border-color: var(--mac-card-border);
    }
    .mac-btn-action.primary {
      background: var(--mac-accent);
      color: white;
      border-color: var(--mac-accent);
    }
    .mac-btn-action.primary:hover {
      background: var(--mac-accent-hover);
    }
    .mac-btn-action.teams {
      background: var(--teams);
      color: white;
      border-color: var(--teams);
    }
    .mac-btn-action.teams:hover {
      background: var(--teams-hover);
    }
    .mac-btn-action.vcf {
      flex: 0 0 34px;
      padding: 0;
      font-size: 0.85rem;
    }

    /* macOS Table View */
    .mac-table-card {
      background: var(--mac-card-bg);
      border: 1px solid var(--mac-card-border);
      border-radius: 16px;
      overflow-x: auto;
      box-shadow: var(--mac-card-shadow);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.86rem;
    }
    th {
      background: var(--mac-bg);
      color: var(--mac-text-secondary);
      font-weight: 600;
      padding: 10px 14px;
      border-bottom: 1px solid var(--mac-border);
      text-transform: uppercase;
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
    td {
      padding: 10px 14px;
      border-bottom: 1px solid var(--mac-border);
      color: var(--mac-text);
    }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: rgba(0, 0, 0, 0.02); }
    [data-theme="dark"] tr:hover td { background: rgba(255, 255, 255, 0.03); }

    .empty-state {
      text-align: center;
      padding: 50px 20px;
      color: var(--mac-text-secondary);
      font-size: 0.95rem;
    }

    /* macOS Floating Toast Notification */
    .mac-toast {
      position: fixed;
      bottom: 26px;
      right: 26px;
      background: rgba(29, 29, 31, 0.85);
      color: white;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      padding: 11px 20px;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
      font-size: 0.84rem;
      font-weight: 500;
      opacity: 0;
      pointer-events: none;
      transform: translateY(12px) scale(0.97);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 9999;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }
    [data-theme="dark"] .mac-toast {
      background: rgba(45, 45, 50, 0.9);
    }
    .mac-toast.show {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    /* ImpressÃ£o Limpa em PDF */
    @media print {
      body { background: white !important; color: black !important; }
      .mac-window-header, .mac-toolbar, .mac-card-footer, .mac-copy-btn { display: none !important; }
      .container { max-width: 100% !important; padding: 0 !important; }
      .print-header { display: block !important; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 2px solid #0071e3; }
      .print-header h2 { font-size: 15pt; color: #0071e3; }
      .print-header p { font-size: 9.5pt; color: #555; }
      #contactsGrid { display: none !important; }
      #contactsTableContainer { display: block !important; border: none !important; }
      table { font-size: 8.5pt !important; width: 100% !important; }
      th, td { padding: 4px 6px !important; border-bottom: 1px solid #ddd !important; }
      th { background: #f0f4f8 !important; color: #333 !important; }
      .mac-badge { border: 1px solid #999; color: black !important; background: none !important; }
    }
    .print-header { display: none; }
  </style>
</head>
<body>

  <!-- macOS Window Header Bar -->
  <header class="mac-window-header">
    <div class="mac-left-section">
      <!-- Traffic Lights -->
      <div class="mac-traffic-lights">
        <span class="traffic-dot dot-close" title="Fechar"></span>
        <span class="traffic-dot dot-minimize" title="Minimizar"></span>
        <span class="traffic-dot dot-expand" title="EcrÃ£ Inteiro"></span>
      </div>

      <!-- App Title Group -->
      <div class="mac-title-group">
        <div class="mac-republica-emblem" title="RepÃºblica Portuguesa">
          <svg viewBox="0 0 100 100">
            <circle cx="50" cy="50" r="46" fill="#006600"/>
            <path d="M 50,4 A 46,46 0 0,1 96,50 L 50,50 Z" fill="#CC0000"/>
            <path d="M 96,50 A 46,46 0 0,1 50,96 L 50,50 Z" fill="#CC0000"/>
            <circle cx="50" cy="50" r="24" fill="#FFCC00" stroke="#000" stroke-width="2"/>
            <rect x="42" y="38" width="16" height="24" rx="2" fill="#FFFFFF" stroke="#000" stroke-width="1.5"/>
            <path d="M 46,44 L 54,44 M 50,40 L 50,58" stroke="#003399" stroke-width="2.5"/>
          </svg>
        </div>
        <div class="mac-title-text">
          <h1>MinistÃ©rio das FinanÃ§as &bull; DiretÃ³rio</h1>
          <p>SEAO &bull; SEAF &bull; SEAP &bull; LogÃ­stica</p>
        </div>
      </div>
    </div>

    <!-- macOS Center: Segmented Navigation -->
    <div class="mac-segmented-control">
      <button class="mac-segment-btn active" id="tabBtnContacts" onclick="switchTab('contacts')">
        &#128100; Colaboradores
      </button>
      <button class="mac-segment-btn" id="tabBtnResources" onclick="switchTab('resources')">
        &#128663; Frota & Salas
      </button>
    </div>

    <!-- macOS Right: Counter Badge & Dark Mode Button -->
    <div class="mac-right-section">
      <div class="mac-pill-badge">
        <span>Total:</span>
        <strong id="stat-contacts">53</strong>
      </div>
      <button class="mac-btn-icon" id="themeBtn" onclick="toggleTheme()" title="Alternar Tema Claro / Escuro">
        &#127769;
      </button>
    </div>
  </header>

  <div class="container">
    <div class="print-header">
      <h2>MinistÃ©rio das FinanÃ§as â€” DiretÃ³rio de Contactos</h2>
      <p id="printSubtitle">Listagem Oficial dos Gabinetes (SEAO â€¢ SEAF â€¢ SEAP)</p>
    </div>

    <!-- macOS Sub-Toolbar (Search + Segmented Filters) -->
    <div class="mac-toolbar">
      <div class="mac-search-wrapper">
        <span class="mac-search-icon">&#128269;</span>
        <input type="text" id="searchInput" placeholder="Pesquisar por nome, cargo, ramal, sala, email... (prima /)" oninput="filterData()">
      </div>

      <div class="mac-filter-label">Gabinete:</div>
      <div class="mac-segmented-group">
        <button class="mac-filter-item active" id="btnGab-ALL" onclick="setCabinet('ALL')">Todos</button>
